# Admin portal — preprod (Vite, baked at Docker build)
# GitLab: DEMO_HOST=<preprod-host>, VITE_APP_ENV=preprod
# API still uses a dedicated preprod MySQL (fill MYSQL_* when DBA provides it); OTP is preprod Maxit.

VITE_APP_ENV=preprod
VITE_API_URL=http://FILL_PREPROD_HOST:3001/api/v1
VITE_AUTH_API_URL=http://FILL_PREPROD_HOST:3001/api/v1
VITE_USER_API_URL=http://FILL_PREPROD_HOST:3001/api/v1
VITE_CONFIG_API_URL=http://FILL_PREPROD_HOST:3001/api/v1
VITE_SURVEY_API_URL=http://FILL_PREPROD_HOST:3001/api/v1
VITE_SQUAD_API_URL=http://FILL_PREPROD_HOST:3001/api/v1
