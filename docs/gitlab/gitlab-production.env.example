# Production GitLab CI/CD Variables — myboss-admin ONLY (admin container)
# Image: myboss-admin/docker/Dockerfile — no build args, no secrets in the image.
# No localhost / 127.0.0.1. Replace TODO_DEPLOY_* with the public API ingress.

VITE_API_URL=TODO_DEPLOY_API_PUBLIC_URL/api/v1
VITE_APP_ENV=production
# Do not set PORT. DevOps / K8s uses APP_PORT=80. The admin image defaults to 80.
